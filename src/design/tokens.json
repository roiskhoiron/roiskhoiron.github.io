  "derived": {
    "$description": "Computed from the active palette at runtime; never hard-code them.",
    "line": {
      "$type": "color",
      "$value": "color-mix(in srgb, var(--fg) 24%, transparent)",
      "$description": "Hairlines and quiet borders."
    },
    "soft": {
      "$type": "color",
      "$value": "color-mix(in srgb, var(--fg) 74%, var(--bg))",
      "$description": "Secondary text."
    },
    "code-soft": {
      "$type": "color",
      "$value": "color-mix(in srgb, var(--code-ink) 78%, transparent)",
      "$description": "Secondary text inside dark code areas."
    }
